PORT=5000
MONGODB_URI=
JWT_SECRET=

# Password reset — link sent to the user points back to this frontend URL
CLIENT_URL=http://localhost:5173

# Gmail SMTP — used to send password-reset emails via nodemailer.
# GMAIL_APP_PASSWORD is a 16-character Google "App Password", NOT your
# normal Gmail account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=